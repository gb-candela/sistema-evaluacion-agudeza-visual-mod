    <html-property name="description">Demonstrates how to include diagrams images from a UML model, rendered using a configurable image resolution. This is a strategy that can be used to balance diagram image quality with required memory.</html-property>
    <method name="initialize"><![CDATA[var max = 100;
var rowCount = 0;
var packageNames = new Array(max);
var packageDocs = new Array(max);]]></method>
