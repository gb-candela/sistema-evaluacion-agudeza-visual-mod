                <structure>
                    <property name="name">reportTitle</property>
                    <property name="displayName">reportTitle</property>
                    <expression name="expression">names ="";
for(i=0;i&lt;rowCount;i++){
	if(i==0){
		names += packageNames[i];
	}else{
		names += ", "+ packageNames[i];
	}
}
args = new Array(1);
args[0] = names;
reportContext.getMessage("umlModelDiagrams_title", reportContext.getLocale(), args);</expression>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <property name="resultSetColumn">reportTitle</property>
        </data>
