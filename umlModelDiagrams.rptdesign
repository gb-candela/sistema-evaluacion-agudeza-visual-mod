            <property name="marginLeft">24pt</property>
            <list-property name="boundDataColumns">
                <structure>
                    <property name="name">documentation</property>
                    <property name="displayName">documentation</property>
                    <expression name="expression">doc = "";
for(i=0;i&lt;rowCount;i++){
	doc += packageDocs[i];
	if(i != (rowCount -1) &amp;&amp; doc != ""){
		doc += "\n";
	}
}
if(doc == ""){
	reportContext.getMessage("nodocumentation", reportContext.getLocale(), null);
}</expression>
                </structure>
            </list-property>
            <expression name="valueExpr">row["documentation"]</expression>
            <property name="contentType">html</property>
